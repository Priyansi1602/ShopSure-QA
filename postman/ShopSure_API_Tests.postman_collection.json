        {
          "name": "PROD_08: Filter Products by Category Slug",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All returned products belong to filtered category\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var categorySlug = pm.environment.get(\"categorySlug\") || \"smartphones\";",
                  "    pm.expect(jsonData.products).to.be.an(\"array\").and.not.empty;",
                  "    jsonData.products.forEach(function(item) {",
                  "        pm.expect(item.category.toLowerCase()).to.eql(categorySlug.toLowerCase());",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/category/{{categorySlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "category",
                "{{categorySlug}}"
              ]
            },
            "description": "Filters catalog by category slug and verifies every returned item matches that category."
          },
          "response": []
        }
