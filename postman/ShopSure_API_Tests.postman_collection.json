  "item": [
    {
      "name": "1. Products",
      "description": "Validation of product catalog, single product lookup, boundary IDs, search functionality, category filters, and error handling.",
      "item": [
        {
          "name": "PROD_01: Retrieve All Products (Pagination & Limits)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is within acceptable threshold\", function () {",
                  "    var maxTime = Number(pm.environment.get(\"maxResponseTime\")) || 3000;",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxTime);",
                  "});",
                  "",
                  "pm.test(\"Response body has required pagination fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"products\");",
                  "    pm.expect(jsonData).to.have.property(\"total\");",
                  "    pm.expect(jsonData).to.have.property(\"skip\");",
                  "    pm.expect(jsonData).to.have.property(\"limit\");",
                  "    pm.expect(Array.isArray(jsonData.products)).to.be.true;",
                  "    pm.expect(jsonData.limit).to.eql(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=5&skip=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "skip",
                  "value": "0"
                }
              ]
            },
            "description": "Validates retrieval of the product catalog with pagination query parameters limit=5 and skip=0."
          },
          "response": []
        },
        {
          "name": "PROD_02: Retrieve Product by Valid ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Product ID matches requested ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedId = Number(pm.environment.get(\"validProductId\")) || 1;",
                  "    pm.expect(jsonData.id).to.eql(expectedId);",
                  "});",
                  "",
                  "pm.test(\"Product schema attributes and types are valid\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.price).to.be.a(\"number\").and.be.above(0);",
                  "    pm.expect(jsonData.category).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.stock).to.be.a(\"number\").and.be.at.least(0);",
                  "    pm.expect(jsonData.rating).to.be.a(\"number\").and.be.within(0, 5);",
                  "    pm.expect(jsonData.images).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{validProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{validProductId}}"
              ]
            },
            "description": "Validates retrieving a specific single product using a valid existing ID."
          },
          "response": []
        },
        {
          "name": "PROD_03: Retrieve Product by Invalid ID (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error message explains product not found\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "    pm.expect(jsonData.message).to.include(\"not found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{invalidProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{invalidProductId}}"
              ]
            },
            "description": "Verifies that querying a non-existent out-of-bounds product ID (99999) returns a standard 404 response."
          },
          "response": []
        },
        {
          "name": "PROD_04: Retrieve Product by Boundary Negative ID (Boundary)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found for negative ID\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error message correctly identifies negative ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "    pm.expect(jsonData.message).to.include(\"-1\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/-1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "-1"
              ]
            },
            "description": "Boundary value test verifying API handling of negative integer product IDs."
          },
          "response": []
        },
