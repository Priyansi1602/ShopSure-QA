    {
      "name": "3. Shopping Cart",
      "description": "Shopping cart retrieval, cart item calculations, cart simulation (add, update, delete), and boundary checks.",
      "item": [
        {
          "name": "CART_01: Retrieve All Shopping Carts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains carts array and pagination metadata\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"carts\");",
                  "    pm.expect(Array.isArray(jsonData.carts)).to.be.true;",
                  "    pm.expect(jsonData.carts.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Retrieves a list of active carts with pagination."
          },
          "response": []
        },
        {
          "name": "CART_02: Retrieve Cart by Valid ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Cart details and products calculations are consistent\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedId = Number(pm.environment.get(\"validCartId\")) || 1;",
                  "    pm.expect(jsonData.id).to.eql(expectedId);",
                  "    pm.expect(jsonData.products).to.be.an(\"array\").and.not.empty;",
                  "    pm.expect(jsonData.total).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(jsonData.discountedTotal).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(jsonData.totalQuantity).to.be.a(\"number\").and.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
