    {
      "name": "2. Authentication",
      "description": "User login, credential validation, dynamic token extraction, protected profile access, and unauthorized rejection.",
      "item": [
        {
          "name": "AUTH_01: Login with Valid Credentials (Token Capture)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK on valid login\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response returns JWT access token and user info\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "    pm.expect(jsonData.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.username).to.eql(pm.environment.get(\"demoUsername\"));",
                  "    ",
                  "    // Dynamically store token and userId into environment",
                  "    pm.environment.set(\"authToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"currentUserId\", jsonData.id);",
                  "    console.log(\"Auth token captured successfully:\", jsonData.accessToken.substring(0, 15) + \"...\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates with verified demo credentials (emilys / emilyspass) and stores accessToken dynamically into the environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demoUsername}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
